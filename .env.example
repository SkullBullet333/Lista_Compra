# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase: crie o projeto e rode as migrations da pasta supabase/migrations.
# O aplicativo usa Authentication por e-mail e senha; não habilite login anônimo.
NEXT_PUBLIC_SUPABASE_URL="https://SEU-PROJETO.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="SUA_CHAVE_ANON"
# Para desenvolvimento com `supabase start`, use a URL abaixo e a anon key
# exibida por `npx supabase status` (a chave local não deve ser versionada):
# NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="SUA_ANON_KEY_LOCAL"
# Catálogo compartilhado é o padrão. Use false ao reativar o modo por usuário.
NEXT_PUBLIC_SHARED_CATALOG_EDIT="true"
